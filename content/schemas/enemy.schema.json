{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "One enemy type (an entry of enemies in content/waves.json)",
  "type": "object",
  "required": [
    "name",
    "hp",
    "speed",
    "armor",
    "ward",
    "air",
    "leak"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "hp": {
      "type": "number",
      "minimum": 0
    },
    "speed": {
      "type": "number",
      "minimum": 0
    },
    "armor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ward": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "air": {
      "type": "boolean"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "radius": {
      "type": "integer",
      "minimum": 2
    },
    "leak": {
      "type": "integer",
      "minimum": 1
    }
  }
}
