{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A map (content/maps/map_NN.json)",
  "type": "object",
  "required": [
    "id",
    "name",
    "width",
    "height",
    "freeSpots",
    "path",
    "base",
    "spots"
  ],
  "properties": {
    "contractVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^map_[0-9]+$"
    },
    "name": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "minimum": 100
    },
    "height": {
      "type": "integer",
      "minimum": 100
    },
    "freeSpots": {
      "type": "integer",
      "minimum": 1
    },
    "unlockAfterWave": {
      "type": "integer",
      "minimum": 0
    },
    "path": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "base": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "spots": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    }
  }
}
